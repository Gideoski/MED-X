
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account on the Med-X platform.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "isPremium"]
    },
    "Material": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Material",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "downloads": { "type": "number" },
        "isPremium": { "type": "boolean" }
      },
      "required": ["id", "title"]
    },
    "Testimonial": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Testimonial",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "text": { "type": "string" },
        "role": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name", "text"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "type": "object",
      "description": "Global settings like the current live tutorial link.",
      "properties": {
        "tutorialLink": { "type": "string" },
        "tutorialStatus": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/testimonials/{id}",
        "definition": {
          "entityName": "Testimonial",
          "schema": { "$ref": "#/backend/entities/Testimonial" },
          "description": "Student reviews."
        }
      },
      {
        "path": "/config/global",
        "definition": {
          "entityName": "AppConfig",
          "schema": { "$ref": "#/backend/entities/AppConfig" },
          "description": "Global app settings."
        }
      }
    ]
  }
}
